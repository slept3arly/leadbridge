{
  "name": "leadbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/activity-patch-validation.test.ts tests/cache-tags.test.ts tests/crm-sync.test.ts tests/database-readiness.test.ts tests/lead-creation-validation.test.ts tests/lead-workflow-entrypoints.test.ts tests/lead-workflow-form.test.ts tests/lead-workspace.test.ts tests/record-progress-accordion.test.ts tests/record-progress-follow-ups.test.ts tests/note-scheduling-validation.test.ts tests/phase1-hardening.test.ts",
    "test:integration": "node scripts/run-postgres-integration-tests.mjs",
    "db:generate": "pnpm exec prisma generate",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:migrate:status": "pnpm exec prisma migrate status",
    "db:push": "pnpm exec prisma db push",
    "seed:leads": "tsx scripts/seed-leads.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "googleapis": "^173.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
