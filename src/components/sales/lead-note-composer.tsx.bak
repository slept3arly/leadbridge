"use client";

import { useState } from "react";
import axios from "axios";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { MenuItem } from "@/components/ui/menu-item";
import { toast } from "@/lib/toast";

type ActionOption = "Call" | "WhatsApp";
type ResponseOption = "Picked Up" | "No Response" | "Invalid Number" | "Replied";
type InterestOption = "Interested" | "Not Interested";

interface NoteFormValues {
  action: ActionOption;
  response: ResponseOption;
  interest?: InterestOption;
  notes?: string;
  scheduleFollowUp: boolean;
  followUpDate?: string;
  followUpTime?: string;
}

export function LeadNoteComposer({
  leadId,
  onCreated,
}: {
  leadId: string;
  onCreated: () => void;
}) {
  const [form, setForm] = useState<NoteFormValues>({
    action: "Call",
    response: "Picked Up",
    scheduleFollowUp: false,
    notes: "",
  });

  const [saving, setSaving] = useState(false);

  function getResponseOptions(action: string) {
    if (action === "Call") {
      return ["Picked Up", "No Response", "Invalid Number"];
    }
    return ["Replied", "No Response", "Invalid Number"];
  }

  function getInterestOptions(response: string) {
    if (response === "Picked Up" || response === "Replied") {
      return ["Interested", "Not Interested"];
    }
    return [];
  }

  function getInterestLabel(response: string | undefined) {
    if (response === "Picked Up" || response === "Replied") {
      return "Interest";
    }
    return "—";
  }

  async function submit() {
    setSaving(true);
    try {
      await axios.post(`/api/leads/${leadId}/notes`, {
        action: form.action,
        response: form.response,
        interest: form.interest,
        notes: form.notes?.trim() || null,
        scheduleFollowUp: form.scheduleFollowUp,
        followUpDate: form.followUpDate || null,
        followUpTime: form.followUpTime || null,
      });
      toast.success("Note added");
      setForm({
        action: "Call",
        response: "Picked Up",
        scheduleFollowUp: false,
        notes: "",
      });
      onCreated();
    } catch {
      toast.error("Failed to add note");
    } finally {
      setSaving(false);
    }
  }

  const handleToggleFollowUp = (checked: boolean) => {
    setForm({ ...form, scheduleFollowUp: checked });
  };

  return (
    <div className="rounded-xl border border-[var(--color-border)] bg-[var(--color-panel)] p-4 space-y-3">
      <div className="space-y-2">
        <label className="text-xs font-semibold text-[var(--color-muted)]">Action</label>
        <Select
          value={form.action}
          onChange={(e) =>
            setForm((prev) => ({
              ...prev,
              action: e.target.value,
              response: getResponseOptions(e.target.value)[0],
            }))
          }
        >
          <MenuItem value="Call">Call</MenuItem>
          <MenuItem value="WhatsApp">WhatsApp</MenuItem>
        </Select>
      </div>

      <div className="space-y-2">
        <label className="text-xs font-semibold text-[var(--color-muted)]">Response</label>
        <Select
          value={form.response}
          onChange={(e) =>
            setForm((prev) => ({ ...prev, response: e.target.value }))
          }
        >
          {getResponseOptions(form.action).map((option) => (
            <MenuItem key={option} value={option}>
              {option}
            </MenuItem>
          ))}
        </Select>
      </div>

      <div className="space-y-2">
        <label className="text-xs font-semibold text-[var(--color-muted)]">
          {getInterestLabel(form.response)}
        </label>
        {getInterestOptions(form.response).length > 0 && (
          <Select
            value={form.interest ?? "Interested"}
            onChange={(e) =>
              setForm((prev) => ({ ...prev, interest: e.target.value }))
            }
          >
            <MenuItem value="Interested">Interested</MenuItem>
            <MenuItem value="Not Interested">Not Interested</MenuItem>
          </Select>
        )}
        {getInterestOptions(form.response).length === 0 && (
          <p className="text-xs text-[var(--color-muted)]">
            Interest not applicable
          </p>
        )}
      </div>

      <div className="space-y-2">
        <label className="text-xs font-semibold text-[var(--color-muted)]">Notes</label>
        <Input
          placeholder="Additional context..."
          value={form.notes ?? ""}
          onChange={(e) => setForm({ ...form, notes: e.target.value })}
        />
      </div>

      <div className="space-y-1">
        <label className="flex items-center gap-2 cursor-pointer">
          <input
            type="checkbox"
            checked={form.scheduleFollowUp}
            onChange={(e) => handleToggleFollowUp(e.target.checked)}
            className="rounded border-[var(--color-border)] text-[var(--color-brand)] focus:ring-[var(--color-brand)]"
          />
          <span className="text-sm font-medium text-[var(--color-ink)]">
            Schedule Follow Up?
          </span>
        </label>
      </div>

      {form.scheduleFollowUp && (
        <div className="grid grid-cols-2 gap-3">
          <div className="space-y-1">
            <label className="text-xs font-medium text-[var(--color-muted)]">Date</label>
            <Input
              type="date"
              value={form.followUpDate ?? ""}
              onChange={(e) => setForm({ ...form, followUpDate: e.target.value })}
            />
          </div>
          <div className="space-y-1">
            <label className="text-xs font-medium text-[var(--color-muted)]">Time</label>
            <Input
              type="time"
              value={form.followUpTime ?? ""}
              onChange={(e) => setForm({ ...form, followUpTime: e.target.value })}
            />
          </div>
        </div>
      </div>

      <div className="flex items-center gap-2 pt-1">
        <Button
          size="sm"
          isLoading={saving}
          onClick={submit}
          disabled={!form.notes.trim()}
        >
          Save Note
        </Button>
        <Button size="sm" variant="ghost" onClick={() => setForm({
          action: "Call",
          response: "Picked Up",
          scheduleFollowUp: false,
          notes: "",
        })}>
          Cancel
        </Button>
      </div>
    </div>
  );
}